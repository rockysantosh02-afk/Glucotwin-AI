# ==============================================================================
# GlucoTwin AI - Environment Configuration Example
# Research & Education Prototype - Synthetic Patient Data Only
# ==============================================================================

# Application Metadata
APP_NAME=GlucoTwin AI
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Security and Authentication
# WARNING: Generate a secure 32+ character random string for production
SECRET_KEY=replace_with_a_secure_random_string_of_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Default target: PostgreSQL with asyncpg driver
DATABASE_URL=postgresql+asyncpg://glucotwin_user:glucotwin_password@localhost:5432/glucotwin_db
# Local SQLite fallback for environments without a running PostgreSQL instance
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./glucotwin_dev.db
USE_SQLITE_FALLBACK=true

# Cross-Origin Resource Sharing (CORS) & Host Filtering
# Comma-separated list of allowed origins (No wildcards in production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated list of allowed host headers (No wildcards in production)
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# JWT Claims Configuration
JWT_ISSUER=glucotwin-ai
JWT_AUDIENCE=glucotwin-client

# Frontend Configuration (Used at build time in frontend/.env or Render Static Site)
# VITE_API_BASE_URL=https://<your-backend-service>.onrender.com

# Clinical Safety & Compliance Guardrails
# Mandatory: System operates strictly as a research/education prototype
RESEARCH_MODE_ONLY=true
ALLOW_SYNTHETIC_DATA_ONLY=true
ENFORCE_GUARDRAILS=true
# Prohibit any output resembling insulin dosing or medication recommendations
ENABLE_RECOMMENDATION_BLOCKER=true

# Digital Twin Simulation & Physiological Model Parameters
MODEL_TYPE=arx_kalman
PREDICTION_HORIZON_MINUTES=60
SIMULATION_TIME_STEP_MINUTES=5
TARGET_GLUCOSE_MIN=70.0
TARGET_GLUCOSE_MAX=180.0
HYPO_GLUCOSE_THRESHOLD=70.0
HYPER_GLUCOSE_THRESHOLD=180.0
SEVERE_HYPO_THRESHOLD=54.0
SEVERE_HYPER_THRESHOLD=250.0
